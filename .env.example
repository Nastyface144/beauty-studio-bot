# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-bot-token

# Telegram ID администратора (узнать: @userinfobot). Можно несколько через запятую
ADMIN_ID=123456789

# Платёжный токен ЮKassa (тестовый) из @BotFather → Bot Settings → Payments.
# Если оставить пустым, предоплата работает в демо-режиме (кнопка «Оплатить (демо)»)
PAYMENT_TOKEN=

# Часовой пояс студии
TIMEZONE=Europe/Moscow

# Данные студии (необязательно — есть значения по умолчанию)
STUDIO_NAME=Bloom Beauty Studio
STUDIO_ADDRESS=Москва, ул. Цветочная, 12, 2 этаж
STUDIO_PHONE=+7 (999) 123-45-67
STUDIO_INSTAGRAM=@bloom.beauty.studio
STUDIO_MAP_URL=https://yandex.ru/maps/

# График работы
WORK_START=09:00
WORK_END=20:00

# На сколько дней вперёд можно записаться (1–60)
BOOKING_DAYS=30

# Во сколько админу приходит сводка записей на завтра
DIGEST_TIME=20:00

# Путь к базе SQLite (рядом с ней бот пишет журнал bot.log)
DB_PATH=data/studio.db
